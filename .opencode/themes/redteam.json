{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "void": "#080203",
    "panel": "#150709",
    "raise": "#2b0d11",
    "edge": "#4d161a",
    "blood": "#c8102e",
    "red": "#ff2b2b",
    "red_hot": "#ff5c5c",
    "red_pale": "#ffb3ab",
    "red_dim": "#a85551",
    "text": "#ffe4e0",
    "amber": "#ff9b3d"
  },
  "theme": {
    "primary": { "dark": "red", "light": "red" },
    "secondary": { "dark": "red_pale", "light": "red_pale" },
    "accent": { "dark": "blood", "light": "blood" },
    "error": { "dark": "red_hot", "light": "red_hot" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "red_pale", "light": "red_pale" },
    "info": { "dark": "red", "light": "red" },
    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "red_dim", "light": "red_dim" },
    "background": { "dark": "void", "light": "void" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "raise", "light": "raise" },
    "border": { "dark": "edge", "light": "edge" },
    "borderActive": { "dark": "red", "light": "red" },
    "borderSubtle": { "dark": "edge", "light": "edge" },
    "diffAdded": { "dark": "red_pale", "light": "red_pale" },
    "diffRemoved": { "dark": "red_hot", "light": "red_hot" },
    "diffContext": { "dark": "raise", "light": "raise" },
    "diffHunkHeader": { "dark": "raise", "light": "raise" },
    "diffHighlightAdded": { "dark": "red", "light": "red" },
    "diffHighlightRemoved": { "dark": "red_hot", "light": "red_hot" },
    "diffAddedBg": { "dark": "raise", "light": "raise" },
    "diffRemovedBg": { "dark": "raise", "light": "raise" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "red_dim", "light": "red_dim" },
    "diffAddedLineNumberBg": { "dark": "raise", "light": "raise" },
    "diffRemovedLineNumberBg": { "dark": "raise", "light": "raise" },
    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "red", "light": "red" },
    "markdownLink": { "dark": "red", "light": "red" },
    "markdownLinkText": { "dark": "red_pale", "light": "red_pale" },
    "markdownCode": { "dark": "red_pale", "light": "red_pale" },
    "markdownBlockQuote": { "dark": "red_dim", "light": "red_dim" },
    "markdownEmph": { "dark": "red_hot", "light": "red_hot" },
    "markdownStrong": { "dark": "red", "light": "red" },
    "markdownHorizontalRule": { "dark": "edge", "light": "edge" },
    "markdownListItem": { "dark": "red", "light": "red" },
    "markdownListEnumeration": { "dark": "red_pale", "light": "red_pale" },
    "markdownImage": { "dark": "red", "light": "red" },
    "markdownImageText": { "dark": "red_pale", "light": "red_pale" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },
    "syntaxComment": { "dark": "red_dim", "light": "red_dim" },
    "syntaxKeyword": { "dark": "red", "light": "red" },
    "syntaxFunction": { "dark": "red_pale", "light": "red_pale" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "red_pale", "light": "red_pale" },
    "syntaxNumber": { "dark": "blood", "light": "blood" },
    "syntaxType": { "dark": "red", "light": "red" },
    "syntaxOperator": { "dark": "text", "light": "text" },
    "syntaxPunctuation": { "dark": "red_dim", "light": "red_dim" }
